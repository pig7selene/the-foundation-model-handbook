// Shared mathematical conventions. New notation belongs here before it appears
// in a chapter, so symbols remain consistent across the manuscript.

#let notation-guide = [
  Shared conventions: token positions use $t$; a token sequence is $x_1, dots, x_T$;
  hidden states use $h_t$; model parameters use $theta$; and a vocabulary uses $cal(V)$.
]

#let vector(symbol) = math.bold(symbol)
#let matrix(symbol) = math.bold(symbol)
